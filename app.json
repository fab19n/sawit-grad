{
  "expo": {
    "name": "SawitGrad",
    "slug": "sawitgrad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "sawitgrad",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2B2200"
    },
    "android": {
      "package": "com.sawitgrad.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2B2200"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "SawitGrad memerlukan akses kamera untuk gambar FFB.",
          "cameraPermission": "SawitGrad memerlukan akses kamera untuk gambar FFB."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5eb87ed0-eeb1-4c18-9f55-9064b8f54dd5"
      }
    }
  }
}
